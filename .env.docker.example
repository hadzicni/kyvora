# Copy this file to .env before using docker compose.
# Never commit .env.
# Change every change-me value.
# Generate secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=change-me

KYVORA_JWT_SECRET=change-me-at-least-32-characters
NEXTAUTH_SECRET=change-me-at-least-32-characters

NEXTAUTH_URL=http://localhost:3000
