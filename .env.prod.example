# Change every change-me value.
# Generate secrets with: openssl rand -base64 48

KYVORA_VERSION=latest

# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://kyvora.example.com
NEXTAUTH_URL=http://localhost:3000

KYVORA_WEB_PORT=3000

POSTGRES_DB=kyvora
POSTGRES_USER=kyvora
POSTGRES_PASSWORD=change-me-postgres-password

KYVORA_JWT_SECRET=change-me-at-least-32-random-characters

NEXTAUTH_SECRET=change-me-nextauth-secret
