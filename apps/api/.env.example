# Local development runs on an embedded H2 database by default.
# No PostgreSQL server is required and no datasource variables need to be set.
SPRING_PROFILES_ACTIVE=local

# Only needed when developing against a real PostgreSQL:
# SPRING_PROFILES_ACTIVE=postgres
# KYVORA_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kyvora
# KYVORA_DATASOURCE_USERNAME=kyvora
# KYVORA_DATASOURCE_PASSWORD=kyvora

# Generate with `openssl rand -base64 32`
KYVORA_JWT_SECRET=
KYVORA_JWT_ACCESS_TOKEN_TTL_SECONDS=900
KYVORA_REFRESH_TOKEN_TTL_SECONDS=2592000
