{
  "name": "kyvora",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:web": "NODE_OPTIONS='--max-old-space-size=8192' npm run dev -w apps/web",
    "dev:api": "cd apps/api && bash -lc 'set -a && source .env.local && set +a && gradle bootRun'",
    "dev:agent": "cd apps/agent && go run ./cmd/kyvora-agent",
    "db:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:logs": "docker compose -f infrastructure/docker-compose.yml logs -f postgres",
    "docker:dev:config": "docker compose -f docker-compose.dev.yml config",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:prod:config": "docker compose -f docker-compose.prod.yml config",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:pull": "docker compose -f docker-compose.prod.yml pull",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "release:prepare": "bash scripts/prepare-release.sh",
    "release:check": "bash scripts/check-release.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
